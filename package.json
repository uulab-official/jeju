{
  "name": "jeju",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@mj-studio/react-native-naver-map": "^2.9.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.6",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "fast-xml-parser": "^5.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-appwrite": "^0.34.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "postinstall": "node scripts/patch-expo-modules-jsi.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest",
    "push:check": "node scripts/expo-push-config-check.js . --require-remote",
    "startup:check": "node scripts/startup-config-check.js .",
    "appwrite:check": "node scripts/appwrite-config-check.js",
    "appwrite:push": "appwrite push all --all --force",
    "appwrite:collect": "appwrite functions create-execution --function-id collect-jeju-culture --body '{}' --async true",
    "appwrite:collect:culture": "appwrite functions create-execution --function-id collect-jeju-culture --body '{}' --async true",
    "appwrite:collect:tourism": "appwrite functions create-execution --function-id collect-jeju-tourism --body '{}' --async true",
    "appwrite:collect:tourism:full": "appwrite functions create-execution --function-id collect-jeju-tourism --body '{\"full\":true}' --async true",
    "data:health": "node scripts/data-health-check.js",
    "test:data": "node --test functions/collect-jeju-tourism/test/collector.test.mjs functions/collect-jeju-culture/test/collector.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run doctor && npm run startup:check && npm run appwrite:check && npm run test:data",
    "preflight": "npm run verify && npx expo install --check && npx expo config --type public > /tmp/jeju-expo-config.txt",
    "preflight:test": "npm run preflight",
    "preflight:production": "npm run push:check && npm run preflight",
    "preflight:update": "npm run verify && npx expo install --check && npx expo config --type public > /tmp/jeju-expo-update-config.txt",
    "guard:update": "node scripts/ota-native-guard.js",
    "release:build": "node scripts/set-build-number.js",
    "release:version": "node scripts/set-release-version.js",
    "test:store-assets": "ruby scripts/app-store-screenshot-integrity.test.rb",
    "release:assets:check": "npm run test:store-assets && node scripts/verify-release-asset-isolation.js",
    "build:local:ios": "mkdir -p dist && eas build --profile production --platform ios --local --non-interactive --output ./dist/jeju-ios-production.ipa",
    "build:local:android": "mkdir -p dist && GRADLE_OPTS='-Dorg.gradle.jvmargs=-Xmx6g -XX:MaxMetaspaceSize=2g -Dfile.encoding=UTF-8' ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk} eas build --profile production --platform android --local --non-interactive --output ./dist/jeju-android-production.aab",
    "build:screenshot:ios": "mkdir -p artifacts && eas build --profile screenshot --platform ios --local --non-interactive --output ./artifacts/jeju-ios-screenshot.tar.gz",
    "screenshots:compose": "node scripts/generate-store-screenshots.mjs",
    "build:testflight:ios": "npm run preflight:production && mkdir -p artifacts && eas build --profile production --platform ios --local --non-interactive --output ./artifacts/jeju-ios-production.ipa",
    "build:play:android": "npm run preflight:production && mkdir -p artifacts && GRADLE_OPTS='-Dorg.gradle.jvmargs=-Xmx6g -XX:MaxMetaspaceSize=2g -Dfile.encoding=UTF-8' ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk} eas build --profile production --platform android --local --non-interactive --output ./artifacts/jeju-android-production.aab",
    "submit:ios": "npm run release:assets:check && eas submit --profile production --platform ios --path ./dist/jeju-ios-production.ipa --non-interactive",
    "submit:android": "npm run release:assets:check && eas submit --profile production --platform android --path ./dist/jeju-android-production.aab --non-interactive",
    "update": "node scripts/uulab-expo-harness.js ota all --message",
    "update:msg": "node scripts/uulab-expo-harness.js ota all --message",
    "ios:match:check": "MATCH_READONLY=true bash scripts/ios-match-sync-check.sh",
    "ios:match:sync-credentials": "MATCH_READONLY=false bash scripts/ios-match-sync-credentials.sh",
    "ios:signing:check": "bash scripts/ios-verify-signing.sh",
    "ios:match": "bundle exec fastlane ios match_appstore",
    "ios:testflight": "bundle exec fastlane ios beta",
    "ios:metadata": "bundle exec fastlane ios metadata",
    "ios:privacy": "bundle exec fastlane ios privacy",
    "ios:prepare-review": "bundle exec fastlane ios prepare_store_version",
    "ios:pricing-status": "bundle exec fastlane ios pricing_status",
    "ios:set-free-price": "bundle exec fastlane ios set_free_price",
    "ios:screenshots:audit": "bundle exec fastlane ios screenshots_audit",
    "ios:screenshots:deduplicate": "bundle exec fastlane ios screenshots_deduplicate",
    "ios:store-status": "bundle exec fastlane ios store_status",
    "ios:cancel-review": "bundle exec fastlane ios cancel_review",
    "ios:submit-review": "npm run release:assets:check && bundle exec fastlane ios submit_review",
    "android:metadata": "bundle exec fastlane android metadata",
    "android:static-assets": "bundle exec ruby scripts/upload-google-play-static-assets.rb",
    "android:screenshots:audit": "bundle exec ruby scripts/verify-google-play-remote-assets.rb",
    "metadata:push": "bash scripts/with-uulab-credentials.sh eas metadata:push",
    "harness": "node scripts/uulab-expo-harness.js",
    "release:audit": "node scripts/uulab-expo-harness.js audit",
    "release:verify": "node scripts/uulab-expo-harness.js verify",
    "release:local": "node scripts/uulab-expo-harness.js release all",
    "android:keyprops": "node scripts/sync-android-key-properties.js",
    "update:ios": "node scripts/uulab-expo-harness.js ota ios --message",
    "update:android": "node scripts/uulab-expo-harness.js ota android --message",
    "ios:upload-xcode": "bundle exec fastlane ios upload_xcode"
  },
  "overrides": {
    "react-native-appwrite": {
      "expo-file-system": "57.0.1"
    }
  },
  "private": true
}
